<?xml version="1.0" encoding="utf-8"?>
<!--
  Torno MSI (WiX Toolset v5, plus the UI and Util extensions). Built by package.ps1:

    wix build torno.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc torno.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install with a setup wizard: Welcome, install folder (Program Files\Torno by
  default, remembered for upgrades), Ready, progress, and a Finish page with a ticked "Launch
  Torno" box. Installs a Start Menu shortcut, torno-cli (and adds its folder to the system PATH), the licence files (including
  THIRD-PARTY-LICENSES.txt), makes Torno the owner of `.sc` (and of the older `.solidcraft` and pre-rename `.solvecraft`), and offers it under
  "Open with" for STEP, IGES, 3MF and STL. `msiexec /qn` installs silently.
  Adapted from PhotoCraft's (storytold/photocraft, Apache-2.0; see ATTRIBUTION.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Never change the UpgradeCode: it is what lets a new MSI replace every earlier install,
       including those from before the SolveCraft -> Torno rename (docs/compatibility.md). -->
  <Package
      Name="Torno"
      Manufacturer="Nodalia"
      Version="$(var.Version)"
      UpgradeCode="C45EE96B-824D-4A3E-A908-320EFDD78AAE"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Torno parametric 3D CAD" Manufacturer="Nodalia" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Torno is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Advertised shortcuts to an .exe need an .exe icon identifier (ICE50). -->
    <Icon Id="TornoIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="TornoIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://getnodalia.github.io/torno/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/getnodalia/torno/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/getnodalia/torno/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Torno" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by TornoApp). -->
    <!-- Since the rename the folder and this key say Torno. A pre-rename install recorded
         Software\SolveCraft, which isn't read: its upgrade (same UpgradeCode) removes the old
         folder and installs into Program Files\Torno (docs/compatibility.md). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Torno" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Torno" Level="1">
      <ComponentGroupRef Id="TornoFiles" />
    </Feature>

    <!-- WixUI_InstallDir without its licence page (MIT OR Apache-2.0: nothing to accept). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTorno"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="TornoVersion" Value="$(var.DisplayVersion)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Torno $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Torno" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#TornoExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user. -->
    <CustomAction Id="LaunchTorno" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="TornoFiles" Directory="INSTALLFOLDER">
      <!-- A new GUID with the rename: the key file changed from solvecraft.exe to torno.exe.
           The UpgradeCode above is unchanged, so this MSI major-upgrades a pre-rename install. -->
      <Component Id="TornoApp" Guid="28B64010-90A0-4888-BD32-470EF2426231">
        <File Id="TornoExe" Source="$(var.BinDir)\torno.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Torno"
              Description="Torno parametric 3D CAD" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="TornoIcon.exe" IconIndex="0" />
        </File>

        <!-- .sc: Torno's own format; Torno is its default app. -->
        <ProgId Id="Torno.Design" Description="Torno Design" Icon="TornoExe" IconIndex="0">
          <Extension Id="sc" ContentType="application/x-torno">
            <Verb Id="open" Command="Open" TargetFile="TornoExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Compatibility shim (docs/compatibility.md): designs saved as .solidcraft (before .sc)
             and as .solvecraft (before the rename) open as the same ProgId. Registered by hand: a
             second Extension under one ProgId would write its open verb twice (WIX0091). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidcraft" Value="Torno.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidcraft" Name="Content Type" Value="application/x-torno" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Value="Torno.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Name="Content Type" Value="application/x-solvecraft" Type="string" />
        <!-- STEP, IGES and meshes: offered under "Open with", never forced as the default. -->
        <ProgId Id="Torno.Model" Description="3D model" Icon="TornoExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Torno.Model\shell\open\command" Value="&quot;[#TornoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.step\OpenWithProgids" Name="Torno.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stp\OpenWithProgids" Name="Torno.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.igs\OpenWithProgids" Name="Torno.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.iges\OpenWithProgids" Name="Torno.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.3mf\OpenWithProgids" Name="Torno.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stl\OpenWithProgids" Name="Torno.Model" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "torno"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe" Name="FriendlyAppName" Value="Torno" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\shell\open\command" Value="&quot;[#TornoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".sc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".solidcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".solvecraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".step" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".stp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".igs" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".iges" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".3mf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\torno.exe\SupportedTypes" Name=".stl" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\torno.exe" Value="[#TornoExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Torno" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="TornoCli">
        <File Id="TornoCliExe" Source="$(var.BinDir)\torno-cli.exe" KeyPath="yes" />
        <!-- The install folder on the system PATH, so MCP clients and shells find `torno-cli` by name;
             removed again on uninstall. -->
        <Environment Id="TornoPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <!-- Compatibility shim (docs/compatibility.md): the old CLI name, forwarding to torno-cli. -->
      <Component Id="TornoCliAlias">
        <File Id="SolvecraftCliAliasExe" Source="$(var.BinDir)\solvecraft-cli.exe" KeyPath="yes" />
      </Component>
      <!-- Several unversioned files: an explicit GUID (WIX0367). -->
      <Component Id="TornoLicences" Guid="B0889465-EEEB-4951-9CA7-7D0A62FFCD31">
        <File Id="LicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
        <File Id="LicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" />
        <File Id="Notice" Source="$(var.BinDir)\NOTICE" />
        <File Id="ThirdParty" Source="$(var.BinDir)\THIRD-PARTY-LICENSES.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
